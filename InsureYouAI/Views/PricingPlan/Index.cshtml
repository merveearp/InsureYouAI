@model AIInsuranceRecommendationViewModel

@{
    ViewData["Title"] = "AI Fiyat Planı Önerisi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="pt-100 pb-100 bg-light">
    <div class="container">
        <div class="row">

            <div class="col-lg-6 mb-4">
                <h2 class="mb-3">Esnek ve Uygun Fiyat Planlarımız</h2>

                <p class="mb-4">
                    Aşağıdaki kısa formu doldurun, AI destekli sigorta asistanımız
                    sizin için en uygun fiyat planını önersin.
                </p>

                <form asp-action="CreateUserCustomizePlan"
                      asp-controller="PricingPlan"
                      method="post">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="Age" class="form-label">Yaş</label>
                            <input asp-for="Age" class="form-control" type="number" min="18" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label">Şehir</label>
                            <input asp-for="City"
                                   class="form-control"
                                   placeholder="İstanbul, Ankara..." />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Occupation" class="form-label">Meslek</label>
                            <input asp-for="Occupation"
                                   class="form-control"
                                   placeholder="Yazılım Mühendisi, Öğretmen..." />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="MaritalStatus" class="form-label">Medeni Durum</label>
                            <select asp-for="MaritalStatus" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Bekar">Bekar</option>
                                <option value="Evli">Evli</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ChildrenCount" class="form-label">Çocuk Sayısı</label>
                            <input asp-for="ChildrenCount"
                                   class="form-control"
                                   type="number"
                                   min="0" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="TravelFrequency" class="form-label">Seyahat Sıklığı</label>
                            <select asp-for="TravelFrequency" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Yılda 1-2 kez">Yılda 1-2 kez</option>
                                <option value="Yılda 3-5 kez">Yılda 3-5 kez</option>
                                <option value="Sık seyahat ediyorum">Sık seyahat ediyorum</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="MonthlyBudget" class="form-label">
                                Aylık Maksimum Bütçe (TL)
                            </label>
                            <input asp-for="MonthlyBudget"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CoveragePriority" class="form-label">
                                Teminat Önceliği
                            </label>
                            <select asp-for="CoveragePriority" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Sağlık">Sağlık</option>
                                <option value="Araç">Araç</option>
                                <option value="Seyahat">Seyahat</option>
                                <option value="Genel Koruma">Genel Koruma</option>
                            </select>
                        </div>

                        <div class="col-12 mb-2 form-check">
                            <input asp-for="HasChronicDisease"
                                   class="form-check-input" />

                            <label asp-for="HasChronicDisease"
                                   class="form-check-label">
                                Kronik bir hastalığım var
                            </label>
                        </div>

                        <div class="col-12 mb-4">
                            <label asp-for="ChronicDiseaseDetails"
                                   class="form-label">
                                Kronik Hastalık Detayı (Opsiyonel)
                            </label>

                            <textarea asp-for="ChronicDiseaseDetails"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Diyabet, tansiyon vb."></textarea>
                        </div>

                        <div class="col-12">
                            <button type="submit"
                                    class="btn btn-primary px-4 py-2">
                                <i class="bi bi-stars"></i>
                                AI ile Bana Uygun Planı Öner
                            </button>
                        </div>

                    </div>
                </form>
            </div>

            <!-- Sağ Alan: AI Sonuç -->
            <div class="col-lg-6">

                @if (!string.IsNullOrEmpty(Model.RecommendedPackage))
                {
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">

                            <h5 class="fw-bold text-primary mb-3">
                                <i class="bi bi-stars"></i>
                                AI Tarafından Önerilen Paket
                            </h5>

                            <div class="alert alert-primary">
                                <h4 class="fw-bold mb-2">
                                    @Model.RecommendedPackage
                                </h4>

                                <span class="badge bg-primary">
                                    En Uygun Eşleşme
                                </span>
                            </div>

                            <h6 class="fw-bold mt-4">
                                Neden Bu Paket?
                            </h6>

                            <p class="text-muted">
                                @Model.AnalysisText
                            </p>

                            @if (!string.IsNullOrEmpty(Model.SecondBestPackage))
                            {
                                <hr />

                                <h6 class="fw-bold">
                                    Alternatif Öneri
                                </h6>

                                <div class="alert alert-warning mb-0">
                                    <strong>
                                        @Model.SecondBestPackage
                                    </strong>
                                </div>
                            }

                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-5 text-center">

                            <i class="bi bi-shield-check display-4 text-primary"></i>

                            <h5 class="mt-3">
                                AI Tavsiye Alanı
                            </h5>

                            <p class="text-muted mb-0">
                                Formu doldurup gönderdiğinizde,
                                AI destekli sigorta asistanımız
                                size en uygun paketi önererek
                                detaylı analiz sunacaktır.
                            </p>

                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</section>